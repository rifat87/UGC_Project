###############################################################################

echo
echo "=== 20. HASH WP7B ARTIFACTS ==="

HASHES="$EVIDENCE/wp7b-hardened.sha256"

sha256sum \
    "$ADMIN_MIDDLEWARE" \
    "$ADMIN_TEST" \
    "$BACK/routes/candidateRoutes.js" \
    "$BACK/routes/voterRoutes.js" \
