#!/usr/bin/env bash
set -euo pipefail

ROOT="$PWD"

if [ "$(basename "$ROOT")" != "VoteChain-ZK" ]; then
    echo "ERROR: run from VoteChain-ZK root."
    exit 2
fi

BACK="$ROOT/votechain-central-server"
FRONT="$ROOT/votechain-frontend-ts"
CRYPTO="$ROOT/crypto"
FOUNDRY="$ROOT/contracts/wp4-foundry"

OUTROOT="../VoteChain_VC-W03_FinalZK/Output/VC-W07"

WP7A="$OUTROOT/VC-W07_WP7A_TARGETED_HARDENING_SUMMARY.txt"
WP7B_CAPTURE="$OUTROOT/VC-W07_WP7B_PRIVILEGED_SURFACE_CAPTURE_SUMMARY.txt"
WP6B="$OUTROOT/VC-W07_WP6B_TRUSTEE_CLI_CONTRACT_FINALIZATION_SUMMARY.txt"

RUN_ID="$(date +%Y%m%d_%H%M%S)"
EVIDENCE="$ROOT/experiments/wp7/$RUN_ID/wp7b-privileged-auth-threshold"
BACKUP="$EVIDENCE/before"

SUMMARY="$OUTROOT/VC-W07_WP7B_PRIVILEGED_AUTH_THRESHOLD_HARDENING_SUMMARY.txt"

ADMIN_MIDDLEWARE="$BACK/middleware/adminRequestSecurity.js"
ADMIN_TEST="$BACK/scripts/wp7b-admin-auth-negative-tests.mjs"

FRONT_ADMIN="$FRONT/src/services/adminAuth.ts"
FRONT_API="$FRONT/src/services/api.ts"

WP6_CORE="$CRYPTO/src/wp6-threshold.mjs"
THRESHOLD_TEST="$CRYPTO/scripts/wp7b-threshold-artifact-negative-tests.mjs"

CONTRACT="$FOUNDRY/src/VoteChainWP4.sol"
WP6_PROFILE="$CRYPTO/config/wp6-threshold-profile.json"

mkdir -p \
    "$EVIDENCE" \
    "$BACKUP" \
    "$BACK/middleware" \
    "$BACK/scripts" \
    "$FRONT/src/services" \
    "$CRYPTO/scripts" \
    "$OUTROOT"

echo
echo "======================================================================"
echo "VOTECHAIN-ZK WP7B — PRIVILEGED AUTH / THRESHOLD ARTIFACT HARDENING"
echo "======================================================================"
echo "RUN_ID=$RUN_ID"
echo
echo "SOURCE_MODIFICATION=YES"
echo "DATABASE_ACCESS=NO"
echo "BIOMETRIC_EXECUTION=NO"
echo "REAL_CREDENTIALS_READ=NO"
echo "FINAL_WP8_BENCHMARK=NO"
echo

###############################################################################
# 1. REQUIRE ACCEPTED PREDECESSORS
###############################################################################

echo "=== 1. REQUIRE WP7A / WP7B CAPTURE / WP6B ==="

grep -q \
    '^STATUS=PASS_WP7A_TARGETED_HARDENING$' \
    "$WP7A"

grep -q \
    '^STATUS=PASS_WP7B_PRIVILEGED_SURFACE_CAPTURE$' \
    "$WP7B_CAPTURE"

grep -q \
    '^STATUS=PASS_WP6B_TRUSTEE_CLI_CONTRACT_FINALIZATION$' \
    "$WP6B"

echo "WP7A_TARGETED_HARDENING=PASS"
echo "WP7B_PRIVILEGED_SURFACE_CAPTURE=PASS"
echo "WP6_THRESHOLD_SUBSYSTEM_FUNCTIONAL_GATE=PASS"

###############################################################################
# 2. BASELINE / BACKUP
###############################################################################

echo
echo "=== 2. BASELINE / BACKUP ==="

CORE_BEFORE="$(
    sha256sum "$WP6_CORE" |
    awk '{print $1}'
)"

PROFILE_BEFORE="$(
    sha256sum "$WP6_PROFILE" |
    awk '{print $1}'
)"

CONTRACT_BEFORE="$(
    sha256sum "$CONTRACT" |
    awk '{print $1}'
)"

echo "WP6_CORE_BEFORE=$CORE_BEFORE"
echo "WP6_PROFILE_BEFORE=$PROFILE_BEFORE"
echo "CONTRACT_BEFORE=$CONTRACT_BEFORE"

FILES=(
    "$BACK/server.js"
    "$BACK/routes/candidateRoutes.js"
    "$BACK/routes/voterRoutes.js"
    "$BACK/routes/biometricRoutes.js"
    "$BACK/controllers/fingerprintController.js"
    "$FRONT_API"
    "$WP6_CORE"
)

for file in "${FILES[@]}"
do
    relative="${file#$ROOT/}"
    mkdir -p "$BACKUP/$(dirname "$relative")"
    cp "$file" "$BACKUP/$relative"
done

echo "WP7B_BACKUP=PASS"

###############################################################################
# 3. WRITE WALLET-SIGNED ADMIN REQUEST MIDDLEWARE
###############################################################################

echo
echo "=== 3. WRITE ADMIN REQUEST SECURITY MIDDLEWARE ==="

cat > "$ADMIN_MIDDLEWARE" <<'JS'
import {
  existsSync,
  mkdirSync,
  readFileSync,
  unlinkSync,
  writeFileSync,
} from 'node:fs'

import {
  dirname,
  join,
  resolve,
} from 'node:path'

import {
  createHash,
} from 'node:crypto'

import {
  getAddress,
  isAddress,
  verifyMessage,
} from 'ethers'

import {
  getWp5Contract,
} from '../utils/wp5Contract.js'

export const ADMIN_AUTH_SCHEME =
  'VoteChainAdmin'

export const ADMIN_AUTH_VERSION =
  'VoteChain-ZK Admin Request v1'

export const ADMIN_REQUEST_MAX_AGE_MS =
  60_000

export const ADMIN_REQUEST_MAX_FUTURE_MS =
  10_000

const NONCE_PATTERN =
  /^[0-9a-f]{32}$/

const SIGNATURE_PATTERN =
  /^0x[0-9a-fA-F]{130}$/

function normalizeJson(
  value,
) {
  if (
    Array.isArray(value)
  ) {
    return value.map(
      normalizeJson,
    )
  }

  if (
    value &&
    typeof value === 'object'
  ) {
    return Object.fromEntries(
      Object
        .keys(value)
        .sort()
        .map(
          key => [
            key,
            normalizeJson(
              value[key],
            ),
          ],
        ),
    )
  }

  return value
}

export function canonicalAdminJson(
  value,
) {
  return JSON.stringify(
    normalizeJson(
      value === undefined
        ? null
        : value,
    ),
  )
}

export function hashAdminBody(
  value,
) {
  return createHash(
    'sha256',
  )
    .update(
      canonicalAdminJson(
        value,
      ),
      'utf8',
    )
    .digest(
      'hex',
    )
}

export function buildAdminRequestMessage({
  audience,
  address,
  method,
  path,
  timestamp,
  nonce,
  bodyHash,
}) {
  return [
    ADMIN_AUTH_VERSION,

    `audience:${
      String(
        audience,
      ).toLowerCase()
    }`,

    `address:${
      String(
        address,
      ).toLowerCase()
    }`,

    `method:${
      String(
        method,
      ).toUpperCase()
    }`,

    `path:${
      String(path)
    }`,

    `timestamp:${
      String(timestamp)
    }`,

    `nonce:${
      String(
        nonce,
      ).toLowerCase()
    }`,

    `body-sha256:${
      String(
        bodyHash,
      ).toLowerCase()
    }`,
  ].join('\n')
}

/*
 * Persistent atomic replay store.
 *
 * A successful admin signature reserves one nonce by atomically creating
 * a nonce file with flag "wx". This survives a backend restart and also
 * prevents two server processes sharing the same directory from accepting
 * the same nonce concurrently.
 *
 * Files contain only random nonce metadata and expiry time.
 */
export function createFileReplayStore(
  directory =
    process.env
      .ADMIN_REPLAY_CACHE_DIR
      ?.trim() ||
    resolve(
      process.cwd(),
      '.runtime',
      'admin-request-nonces',
    ),
) {
  let cleaned = false

  function ensureDirectory() {
    mkdirSync(
      directory,
      {
        recursive: true,
      },
    )
  }

  function cleanup(
    now,
  ) {
    if (cleaned) {
      return
    }

    cleaned = true
    ensureDirectory()

    /*
     * Cleanup is deliberately opportunistic. We only need to remove a
     * stale file when its random nonce happens to be reused.
     * Random 128-bit nonces make that already negligible.
     */
    void now
  }

  function reserve(
    nonce,
    expiresAt,
    now,
  ) {
    cleanup(now)

    const file =
      join(
        directory,
        `${nonce}.json`,
      )

    const payload =
      JSON.stringify({
        nonce,
        expiresAt,
      })

    try {
      writeFileSync(
        file,
        payload,
        {
          flag: 'wx',
          mode: 0o600,
        },
      )

      return true
    } catch (error) {
      if (
        error?.code !==
          'EEXIST'
      ) {
        throw error
      }
    }

    /*
     * An expired nonce artifact can be removed and retried. This is mostly
     * maintenance hygiene; a legitimate 128-bit nonce collision is not
     * expected in practice.
     */
    try {
      const existing =
        JSON.parse(
          readFileSync(
            file,
            'utf8',
          ),
        )

      if (
        Number(
          existing.expiresAt,
        ) <
        Number(now)
      ) {
        unlinkSync(
          file,
        )

        writeFileSync(
          file,
          payload,
          {
            flag: 'wx',
            mode: 0o600,
          },
        )

        return true
      }
    } catch (error) {
      if (
        !existsSync(file)
      ) {
        throw error
      }
    }

    return false
  }

  return {
    directory,
    reserve,
  }
}

let cachedAdminContextPromise =
  null

async function resolveWp5AdminContext() {
  if (
    !cachedAdminContextPromise
  ) {
    cachedAdminContextPromise =
      (
        async () => {
          const contract =
            getWp5Contract()

          const [
            admin,
            audience,
          ] =
            await Promise.all([
              contract.admin(),
              contract.getAddress(),
            ])

          return {
            admin:
              getAddress(
                admin,
              ),

            audience:
              getAddress(
                audience,
              ),
          }
        }
      )()
  }

  try {
    return await cachedAdminContextPromise
  } catch (error) {
    cachedAdminContextPromise =
      null

    throw error
  }
}

function parseAuthorization(
  header,
) {
  if (
    typeof header !==
      'string'
  ) {
    return null
  }

  const prefix =
    `${ADMIN_AUTH_SCHEME} `

  if (
    !header.startsWith(
      prefix,
    )
  ) {
    return null
  }

  const token =
    header
      .slice(
        prefix.length,
      )
      .trim()

  const parts =
    token.split('.')

  if (
    parts.length !==
      4
  ) {
    return null
  }

  const [
    address,
    timestamp,
    nonce,
    signature,
  ] = parts

  if (
    !isAddress(address) ||
    !/^\d{10,16}$/.test(
      timestamp,
    ) ||
    !NONCE_PATTERN.test(
      nonce,
    ) ||
    !SIGNATURE_PATTERN.test(
      signature,
    )
  ) {
    return null
  }

  return {
    address:
      getAddress(
        address,
      ),

    timestamp:
      Number(
        timestamp,
      ),

    nonce:
      nonce.toLowerCase(),

    signature,
  }
}

export function createAdminRequestVerifier({
  resolveAdminContext =
    resolveWp5AdminContext,

  replayStore =
    createFileReplayStore(),

  now =
    () =>
      Date.now(),

  maxAgeMs =
    ADMIN_REQUEST_MAX_AGE_MS,

  maxFutureMs =
    ADMIN_REQUEST_MAX_FUTURE_MS,
} = {}) {
  return async function requireAdminRequest(
    req,
    res,
    next,
  ) {
    const parsed =
      parseAuthorization(
        req.get(
          'authorization',
        ),
      )

    if (!parsed) {
      return res.status(401).json({
        success: false,
        message:
          'A valid administrator wallet signature is required',
      })
    }

    const current =
      Number(
        now(),
      )

    if (
      !Number.isSafeInteger(
        parsed.timestamp,
      ) ||
      parsed.timestamp <
        current -
          maxAgeMs ||
      parsed.timestamp >
        current +
          maxFutureMs
    ) {
      return res.status(401).json({
        success: false,
        message:
          'Administrator request signature is expired or not yet valid',
      })
    }

    let context

    try {
      context =
        await resolveAdminContext()
    } catch {
      return res.status(503).json({
        success: false,
        message:
          'Administrator authority is temporarily unavailable',
      })
    }

    if (
      !context ||
      !isAddress(
        context.admin,
      ) ||
      !isAddress(
        context.audience,
      )
    ) {
      return res.status(503).json({
        success: false,
        message:
          'Administrator authority is not configured correctly',
      })
    }

    const expectedAdmin =
      getAddress(
        context.admin,
      )

    const audience =
      getAddress(
        context.audience,
      )

    if (
      parsed.address
        .toLowerCase() !==
      expectedAdmin
        .toLowerCase()
    ) {
      return res.status(403).json({
        success: false,
        message:
          'The signing wallet is not the election administrator',
      })
    }

    const bodyHash =
      hashAdminBody(
        req.body,
      )

    const message =
      buildAdminRequestMessage({
        audience,
        address:
          parsed.address,
        method:
          req.method,
        path:
          req.originalUrl,
        timestamp:
          parsed.timestamp,
        nonce:
          parsed.nonce,
        bodyHash,
      })

    let recovered

    try {
      recovered =
        getAddress(
          verifyMessage(
            message,
            parsed.signature,
          ),
        )
    } catch {
      return res.status(401).json({
        success: false,
        message:
          'Administrator request signature is invalid',
      })
    }

    if (
      recovered
        .toLowerCase() !==
      expectedAdmin
        .toLowerCase()
    ) {
      return res.status(403).json({
        success: false,
        message:
          'Administrator request signature is not authorized',
      })
    }

    const expiresAt =
      parsed.timestamp +
      maxAgeMs +
      maxFutureMs

    let reserved

    try {
      reserved =
        replayStore.reserve(
          parsed.nonce,
          expiresAt,
          current,
        )
    } catch {
      return res.status(503).json({
        success: false,
        message:
          'Administrator replay protection is temporarily unavailable',
      })
    }

    if (!reserved) {
      return res.status(409).json({
        success: false,
        message:
          'Administrator request replay was rejected',
      })
    }

    req.voteChainAdmin = {
      address:
        expectedAdmin,

      audience,

      timestamp:
        parsed.timestamp,

      nonce:
        parsed.nonce,
    }

    return next()
  }
}

export const requireWp5AdminRequest =
  createAdminRequestVerifier()

export function requireWp5AdminMutation(
  req,
  res,
  next,
) {
  if (
    req.method === 'GET' ||
    req.method === 'HEAD' ||
    req.method === 'OPTIONS'
  ) {
    return next()
  }

  return requireWp5AdminRequest(
    req,
    res,
    next,
  )
}
JS

echo "ADMIN_WALLET_SIGNATURE_MIDDLEWARE=WRITTEN"

###############################################################################
# 4. WRITE FRONTEND ADMIN SIGNING HELPER
###############################################################################

echo
echo "=== 4. WRITE FRONTEND WALLET-SIGNING HELPER ==="

cat > "$FRONT_ADMIN" <<'TS'
import {
  BrowserProvider,
  getAddress,
} from "ethers"

import {
  apiUrl,
} from "@/config/api"

import {
  wp5ContractAddress,
} from "@/config/contract"

const ADMIN_AUTH_SCHEME =
  "VoteChainAdmin"

const ADMIN_AUTH_VERSION =
  "VoteChain-ZK Admin Request v1"

function normalizeJson(
  value: unknown,
): unknown {
  if (
    Array.isArray(value)
  ) {
    return value.map(
      normalizeJson,
    )
  }

  if (
    value &&
    typeof value === "object"
  ) {
    const record =
      value as Record<
        string,
        unknown
      >

    return Object.fromEntries(
      Object
        .keys(record)
        .sort()
        .map(
          key => [
            key,
            normalizeJson(
              record[key],
            ),
          ],
        ),
    )
  }

  return value
}

function canonicalJson(
  value: unknown,
) {
  return JSON.stringify(
    normalizeJson(
      value === undefined
        ? null
        : value,
    ),
  )
}

async function sha256Hex(
  text: string,
) {
  const bytes =
    new TextEncoder()
      .encode(text)

  const digest =
    await crypto.subtle.digest(
      "SHA-256",
      bytes,
    )

  return Array.from(
    new Uint8Array(
      digest,
    ),
    byte =>
      byte
        .toString(16)
        .padStart(
          2,
          "0",
        ),
  ).join("")
}

function randomNonce() {
  const bytes =
    new Uint8Array(16)

  crypto.getRandomValues(
    bytes,
  )

  return Array.from(
    bytes,
    byte =>
      byte
        .toString(16)
        .padStart(
          2,
          "0",
        ),
  ).join("")
}

function bodyValue(
  body:
    | BodyInit
    | null
    | undefined,
) {
  if (
    body === undefined ||
    body === null
  ) {
    return null
  }

  if (
    typeof body !== "string"
  ) {
    throw new Error(
      "Administrator API mutations must use a JSON string body",
    )
  }

  if (
    body.length === 0
  ) {
    return null
  }

  try {
    return JSON.parse(
      body,
    )
  } catch {
    throw new Error(
      "Administrator API mutation body must be valid JSON",
    )
  }
}

function buildMessage({
  audience,
  address,
  method,
  path,
  timestamp,
  nonce,
  bodyHash,
}: {
  audience: string
  address: string
  method: string
  path: string
  timestamp: string
  nonce: string
  bodyHash: string
}) {
  return [
    ADMIN_AUTH_VERSION,
    `audience:${audience.toLowerCase()}`,
    `address:${address.toLowerCase()}`,
    `method:${method.toUpperCase()}`,
    `path:${path}`,
    `timestamp:${timestamp}`,
    `nonce:${nonce.toLowerCase()}`,
    `body-sha256:${bodyHash.toLowerCase()}`,
  ].join("\n")
}

/*
 * Sign one privileged REST mutation with the currently connected wallet.
 *
 * The backend independently reads admin() from the active WP5 Direct
 * contract, so possessing an arbitrary wallet is insufficient.
 */
export async function adminFetch(
  path: string,
  init: RequestInit = {},
) {
  const injected =
    (
      window as unknown as {
        ethereum?: unknown
      }
    ).ethereum

  if (!injected) {
    throw new Error(
      "An injected wallet is required for administrator API mutations",
    )
  }

  if (
    !wp5ContractAddress
  ) {
    throw new Error(
      "VITE_WP5_CONTRACT_ADDRESS is required for administrator API mutations",
    )
  }

  const provider =
    new BrowserProvider(
      injected as never,
    )

  const signer =
    await provider
      .getSigner()

  const address =
    getAddress(
      await signer
        .getAddress(),
    )

  const audience =
    getAddress(
      wp5ContractAddress,
    )

  const method =
    (
      init.method ||
      "GET"
    ).toUpperCase()

  const timestamp =
    String(
      Date.now(),
    )

  const nonce =
    randomNonce()

  const bodyHash =
    await sha256Hex(
      canonicalJson(
        bodyValue(
          init.body,
        ),
      ),
    )

  const message =
    buildMessage({
      audience,
      address,
      method,
      path,
      timestamp,
      nonce,
      bodyHash,
    })

  const signature =
    await signer
      .signMessage(
        message,
      )

  const headers =
    new Headers(
      init.headers,
    )

  headers.set(
    "Authorization",
    `${ADMIN_AUTH_SCHEME} ${address}.${timestamp}.${nonce}.${signature}`,
  )

  return fetch(
    apiUrl(path),
    {
      ...init,
      method,
      headers,
    },
  )
}
TS

echo "FRONTEND_ADMIN_SIGNING_HELPER=WRITTEN"

###############################################################################
# 5. PATCH ACTIVE ROUTES / FRONTEND API / ERROR HYGIENE / WP6 VERIFIER
###############################################################################

echo
echo "=== 5. APPLY WP7B PATCHES ==="

PATCHER="$EVIDENCE/wp7b-patcher.py"

cat > "$PATCHER" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])

back = root / "votechain-central-server"
front = root / "votechain-frontend-ts"
crypto = root / "crypto"

candidate = back / "routes/candidateRoutes.js"
voter = back / "routes/voterRoutes.js"
biometric = back / "routes/biometricRoutes.js"
fingerprint = back / "controllers/fingerprintController.js"
server = back / "server.js"
api = front / "src/services/api.ts"
core = crypto / "src/wp6-threshold.mjs"


def replace_once(path, old, new, label, marker=None):
    text = path.read_text(encoding="utf-8")

    if marker and marker in text:
        print(f"{label}=ALREADY_PATCHED")
        return

    if old not in text:
        raise RuntimeError(
            f"{label}: expected anchor missing in {path}"
        )

    text = text.replace(old, new, 1)
    path.write_text(text, encoding="utf-8")
    print(f"{label}=PATCHED")


# ------------------------------------------------------------------
# Candidate router: every mutation is privileged.
# ------------------------------------------------------------------

text = candidate.read_text(encoding="utf-8")

if "requireWp5AdminMutation" not in text:
    anchor = "import validate from '../middleware/validate.js'\n"

    replacement = """import validate from '../middleware/validate.js'
import {
  requireWp5AdminMutation,
} from '../middleware/adminRequestSecurity.js'
"""

    if anchor not in text:
        raise RuntimeError(
            "candidateRoutes validation import anchor missing"
        )

    text = text.replace(
        anchor,
        replacement,
        1,
    )

    anchor = "const router = express.Router()\n"

    replacement = """const router = express.Router()

router.use(
  requireWp5AdminMutation,
)
"""

    if anchor not in text:
        raise RuntimeError(
            "candidateRoutes router anchor missing"
        )

    text = text.replace(
        anchor,
        replacement,
        1,
    )

    candidate.write_text(
        text,
        encoding="utf-8",
    )

    print("CANDIDATE_ADMIN_GUARD=PATCHED")
else:
    print("CANDIDATE_ADMIN_GUARD=ALREADY_PATCHED")


# ------------------------------------------------------------------
# Voter router: every active mutation is privileged.
# ------------------------------------------------------------------

text = voter.read_text(encoding="utf-8")

if "requireWp5AdminMutation" not in text:
    anchor = "import validate from '../middleware/validate.js';\n"

    replacement = """import validate from '../middleware/validate.js';
import {
  requireWp5AdminMutation,
} from '../middleware/adminRequestSecurity.js';
"""

    if anchor not in text:
        raise RuntimeError(
            "voterRoutes validation import anchor missing"
        )

    text = text.replace(
        anchor,
        replacement,
        1,
    )

    anchor = "const router = express.Router();\n"

    replacement = """const router = express.Router();

router.use(
  requireWp5AdminMutation,
);
"""

    if anchor not in text:
        raise RuntimeError(
            "voterRoutes router anchor missing"
        )

    text = text.replace(
        anchor,
        replacement,
        1,
    )

    voter.write_text(
        text,
        encoding="utf-8",
    )

    print("VOTER_ADMIN_GUARD=PATCHED")
else:
    print("VOTER_ADMIN_GUARD=ALREADY_PATCHED")


# ------------------------------------------------------------------
# Biometric router: protect active enrollment/destructive operations,
# while keeping the legacy DETECT endpoint reachable only to return 410.
# ------------------------------------------------------------------

text = biometric.read_text(encoding="utf-8")

if "requireWp5AdminRequest" not in text:
    anchor = "import fingerprintController from '../controllers/fingerprintController.js';\n"

    replacement = """import fingerprintController from '../controllers/fingerprintController.js';
import {
    requireWp5AdminRequest,
} from '../middleware/adminRequestSecurity.js';
"""

    if anchor not in text:
        raise RuntimeError(
            "biometricRoutes import anchor missing"
        )

    text = text.replace(
        anchor,
        replacement,
        1,
    )

    old = "router.post('/capture-face', async (req, res) => {"
    new = "router.post('/capture-face', requireWp5AdminRequest, async (req, res) => {"

    if old not in text:
        raise RuntimeError(
            "capture-face route anchor missing"
        )

    text = text.replace(
        old,
        new,
        1,
    )

    old = "router.post('/fingerprint/enroll', fingerprintController.captureFingerprint);"
    new = "router.post('/fingerprint/enroll', requireWp5AdminRequest, fingerprintController.captureFingerprint);"

    if old not in text:
        raise RuntimeError(
            "fingerprint enroll route anchor missing"
        )

    text = text.replace(
        old,
        new,
        1,
    )

    old = "router.post('/fingerprint/format', fingerprintController.formatFingerprintDatabase);"
    new = "router.post('/fingerprint/format', requireWp5AdminRequest, fingerprintController.formatFingerprintDatabase);"

    if old not in text:
        raise RuntimeError(
            "fingerprint format route anchor missing"
        )

    text = text.replace(
        old,
        new,
        1,
    )

    biometric.write_text(
        text,
        encoding="utf-8",
    )

    print("BIOMETRIC_ADMIN_GUARDS=PATCHED")
else:
    print("BIOMETRIC_ADMIN_GUARDS=ALREADY_PATCHED")


# ------------------------------------------------------------------
# Remove device/internal exception strings from client responses.
# ------------------------------------------------------------------

text = fingerprint.read_text(
    encoding="utf-8",
)

old = "return res.status(500).json({ success: false, error: error.message })"

if old in text:
    text = text.replace(
        old,
        """return res.status(500).json({
      success: false,
      message: "Fingerprint device operation failed",
    })""",
    )

    fingerprint.write_text(
