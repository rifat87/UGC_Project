    "$WP6_CORE"

echo "PRIVILEGED_ROUTE_GUARDS=PASS"
echo "LEGACY_FINGERPRINT_410_ROUTE_PRESERVED=PASS"
echo "FRONTEND_ADMIN_API_SIGNING_STATIC=PASS"
echo "WP6_THRESHOLD_SECURITY_PATCH_STATIC=PASS"

node - "$BACK/abi/VoteChainDirect.json" <<'NODE'
const fs=require("fs")

const abi=
  JSON.parse(
    fs.readFileSync(
      process.argv[2],
      "utf8"
    )
  )

const hasAdmin=
  abi.some(
    item =>
      item &&
      item.type === "function" &&
      item.name === "admin" &&
      Array.isArray(item.inputs) &&
      item.inputs.length === 0
  )

if (!hasAdmin) {
  throw new Error(
    "VoteChainDirect ABI does not expose admin()"
  )
}

console.log(
  "DIRECT_ABI_ADMIN_GETTER=PASS"
)
NODE

