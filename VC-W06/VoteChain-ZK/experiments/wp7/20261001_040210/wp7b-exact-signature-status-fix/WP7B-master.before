grep -RniE \
    --exclude-dir=node_modules \
    --exclude-dir=dist \
    --include='*.ts' \
    --include='*.tsx' \
    '/api/(voters|candidates|biometric)' \
    "$FRONT/src" \
    > "$CALLS" \
    || true

cat "$CALLS"

CALL_COUNT="$(
    wc -l < "$CALLS" |
    tr -d ' '
)"

echo "FRONTEND_PRIVILEGED_API_STRING_MATCHES=$CALL_COUNT"
echo "NOTE=Callsite count is an inventory, not a vulnerability count."

###############################################################################
# 18. VERIFY ERROR RESPONSE HYGIENE
###############################################################################

echo
echo "=== 18. ERROR RESPONSE HYGIENE ==="

if grep -nE \
    'res\.status\(500\)\.json\(\{ success: false, error: error\.message \}\)' \
    "$BACK/controllers/fingerprintController.js"
then
    echo "ERROR: fingerprint internal error leakage remains."
    exit 50
fi

if grep -nE \
    'error:[[:space:]]*(err|error)\.message' \
    "$BACK/routes/biometricRoutes.js"
then
    echo "ERROR: biometric internal error leakage remains."
    exit 51
fi

grep -q \
    'Request body is too large' \
    "$BACK/server.js"

echo "FINGERPRINT_INTERNAL_ERROR_RESPONSE_LEAK=NO"
echo "BIOMETRIC_INTERNAL_ERROR_RESPONSE_LEAK=NO"
echo "BODY_LIMIT_ERROR_RESPONSE_HYGIENE=PASS"

###############################################################################
# 19. VERIFY CONTRACT / PROFILE UNCHANGED, RECORD INTENTIONAL WP6 CORE PATCH
###############################################################################

echo
echo "=== 19. SOURCE INTEGRITY / INTENTIONAL SECURITY PATCH ==="

PROFILE_AFTER="$(
    sha256sum "$WP6_PROFILE" |
    awk '{print $1}'
)"

CONTRACT_AFTER="$(
    sha256sum "$CONTRACT" |
    awk '{print $1}'
)"

CORE_AFTER="$(
    sha256sum "$WP6_CORE" |
    awk '{print $1}'
)"

if [ "$PROFILE_AFTER" != "$PROFILE_BEFORE" ]; then
    echo "ERROR: WP6 profile changed unexpectedly."
    exit 60
fi

if [ "$CONTRACT_AFTER" != "$CONTRACT_BEFORE" ]; then
    echo "ERROR: voting contract changed unexpectedly."
    exit 61
fi

if [ "$CORE_AFTER" = "$CORE_BEFORE" ]; then
    echo "ERROR: expected WP7 threshold verifier hardening did not change WP6 core."
    exit 62
fi

echo "WP6_PROFILE_CHANGED=NO"
echo "VOTING_CONTRACT_CHANGED=NO"
echo "WP6_CORE_SECURITY_PATCH=YES"
echo "WP6_CORE_BEFORE_SHA256=$CORE_BEFORE"
echo "WP6_CORE_AFTER_SHA256=$CORE_AFTER"

