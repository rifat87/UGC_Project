import {
  beginWp5Authorization,
  prepareWp5EncryptedBallot,
  resetWp5PrivacySession,
} from "./privacy/wp5PrivacyClient"

function bytesToBase64(
  bytes: Uint8Array,
) {
  let binary = ""

  for (
    let index = 0;
    index < bytes.length;
    index += 1
  ) {
    binary +=
      String.fromCharCode(
        bytes[index],
      )
  }

  return btoa(binary)
}

function bufferToBase64(
  buffer: ArrayBuffer,
) {
  return bytesToBase64(
    new Uint8Array(
      buffer,
    ),
  )
}

function resultToBase64(
  value: unknown,
) {
  return bytesToBase64(
    new TextEncoder()
      .encode(
        JSON.stringify(
          value,
        ),
      ),
  )
}

async function makeAuthorization(
  fixture: any,
  clientPublicKey:
    JsonWebKey,
) {
  const serverKeyPair =
    await crypto.subtle.generateKey(
      {
        name: "ECDH",
        namedCurve: "P-256",
      },
      true,
      ["deriveBits"],
    )

  const clientKey =
    await crypto.subtle.importKey(
      "jwk",
      clientPublicKey,
      {
        name: "ECDH",
        namedCurve: "P-256",
      },
      false,
      [],
    )

  const sharedSecret =
    await crypto.subtle.deriveBits(
      {
        name: "ECDH",
        public:
          clientKey,
      },
      serverKeyPair.privateKey,
      256,
    )

  const hkdfInput =
    await crypto.subtle.importKey(
      "raw",
      sharedSecret,
      "HKDF",
      false,
      ["deriveKey"],
    )

  const salt =
    crypto.getRandomValues(
      new Uint8Array(32),
    )

  const iv =
    crypto.getRandomValues(
      new Uint8Array(12),
    )

  const expiresAt =
    Date.now() +
    120_000

  const aadString =
    [
      "VoteChain-ZK/WP5/v1",
      fixture
        .membership
        .identityCommitment,
      fixture
        .publicConfig
        .config
        .electionId,
      String(
        expiresAt,
      ),
    ].join("|")

  const aad =
    new TextEncoder()
      .encode(
        aadString,
      )

  const aesKey =
    await crypto.subtle.deriveKey(
      {
        name: "HKDF",
        hash: "SHA-256",
        salt,
        info:
          new TextEncoder()
            .encode(
              "VoteChain-ZK/WP5/credential-release/v1",
            ),
      },
      hkdfInput,
      {
        name: "AES-GCM",
        length: 256,
      },
      false,
      ["encrypt"],
    )

  const encryptedSecret =
    await crypto.subtle.encrypt(
      {
        name: "AES-GCM",
        iv,
        additionalData:
          aad,
      },
      aesKey,
      new TextEncoder()
        .encode(
          fixture.secret,
        ),
    )

  const serverPublicKey =
    await crypto.subtle.exportKey(
      "jwk",
      serverKeyPair.publicKey,
    )

  return {
    version:
      "VoteChain-ZK-WP5-Authorization-v1",

    electionId:
      fixture
        .publicConfig
        .config
        .electionId,

    expiresAt,

    membership:
      fixture.membership,

    credentialEnvelope: {
      version: 1,

      keyAgreement:
        "ECDH-P256-HKDF-SHA256",

      contentEncryption:
        "AES-256-GCM",

      serverPublicKey,

      salt:
        bytesToBase64(
          salt,
        ),

      iv:
        bytesToBase64(
          iv,
        ),

      aad:
        bytesToBase64(
          aad,
        ),

      ciphertext:
        bufferToBase64(
          encryptedSecret,
        ),

      expiresAt,
    },
  }
}

async function run() {
  const overallStart =
    performance.now()

  const fixtureResponse =
    await fetch(
      "/wp5d-runtime-fixture.json",
      {
        cache:
          "no-store",
      },
    )

  if (
    !fixtureResponse.ok
  ) {
    throw new Error(
      "Could not load WP5D fixture",
    )
  }

  const fixture =
    await fixtureResponse.json()

  const authorizationStart =
    performance.now()

  const {
    credentialPublicKey,
  } =
    await beginWp5Authorization()

  const authorization =
    await makeAuthorization(
      fixture,
      credentialPublicKey,
    )

  const authorizationMs =
    performance.now() -
    authorizationStart

  const privacyStart =
    performance.now()

  const ballot =
    await prepareWp5EncryptedBallot(
      fixture.selectedCandidateId,
      authorization,
      fixture.publicConfig,
    )

  const privacyMs =
    performance.now() -
    privacyStart

  const expectedKeys =
    [
      "a",
      "b",
      "c",
      "nullifier",
      "rx",
      "ry",
      "sx",
      "sy",
    ].sort()

  const actualKeys =
    Object.keys(ballot)
      .sort()

  if (
    JSON.stringify(
      expectedKeys,
    ) !==
    JSON.stringify(
      actualKeys,
    )
  ) {
    throw new Error(
      "Unexpected encrypted-ballot object shape",
    )
  }

  if (
    actualKeys.some(
      key =>
        /candidate/i.test(
          key,
        ),
    )
  ) {
    throw new Error(
      "Candidate plaintext field reached ballot submission object",
    )
  }

  if (
    ballot.rx.length !== 16 ||
    ballot.ry.length !== 16 ||
    ballot.sx.length !== 16 ||
    ballot.sy.length !== 16
  ) {
    throw new Error(
      "Expected 16 encrypted candidate slots",
    )
  }

  const result = {
    status:
      "PASS",

    browserRuntime:
      true,

    syntheticAuthorizationEnvelope:
      true,

    candidatePlaintextInBallotObject:
      false,

    authorizationMs,

    privacyMs,

    overallMs:
      performance.now() -
      overallStart,

    ballot,
  }

  /*
   * Ballot is already copied into the result object.
   * Terminate the privacy worker before reporting PASS.
   */
  resetWp5PrivacySession()

  document.body.dataset.wp5dResult =
    resultToBase64(
      result,
    )

  document.body.dataset.wp5dStatus =
    "PASS"

  document
    .getElementById(
      "status",
    )!
    .textContent =
      "PASS"
}

try {
  await run()
} catch (error) {
  resetWp5PrivacySession()

  const result = {
    status:
      "FAIL",

    error:
      error instanceof Error
        ? error.message
        : String(error),
  }

  document.body.dataset.wp5dResult =
    resultToBase64(
      result,
    )

  document.body.dataset.wp5dStatus =
    "FAIL"

  document
    .getElementById(
      "status",
    )!
    .textContent =
      `FAIL: ${result.error}`
}
