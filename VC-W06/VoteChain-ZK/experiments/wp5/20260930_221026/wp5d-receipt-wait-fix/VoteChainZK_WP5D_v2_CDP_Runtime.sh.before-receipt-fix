import fs from "node:fs"
import {
  Contract,
  JsonRpcProvider,
} from "ethers"

const [
  ,
  ,
  fixturePath,
  browserResultPath,
  directArtifactPath,
  outputPath,
] = process.argv

function readJson(file) {
  return JSON.parse(
    fs.readFileSync(
      file,
      "utf8",
    ),
  )
}

function writeJson(
  file,
  value,
) {
  fs.writeFileSync(
    file,
    JSON.stringify(
      value,
      (_key, item) =>
        typeof item === "bigint"
          ? item.toString()
          : item,
      2,
    ) + "\n",
  )
}

const fixture =
  readJson(
    fixturePath,
  )

const browserResult =
  readJson(
    browserResultPath,
  )

const artifact =
  readJson(
    directArtifactPath,
  )

if (
  browserResult.status !==
  "PASS"
) {
  throw new Error(
    "Browser result is not PASS",
  )
}

const ballot =
  browserResult.ballot

const keys =
  Object.keys(ballot)
    .sort()

const expectedKeys =
  [
    "a",
    "b",
    "c",
    "nullifier",
    "rx",
    "ry",
    "sx",
    "sy",
  ].sort()

if (
  JSON.stringify(keys) !==
  JSON.stringify(
    expectedKeys,
  )
) {
  throw new Error(
    "Unexpected ballot submission shape",
  )
}

if (
  keys.some(
    key =>
      /candidate/i.test(
        key,
      ),
  )
) {
  throw new Error(
    "Candidate plaintext field reached transaction object",
  )
}

const provider =
  new JsonRpcProvider(
    fixture.rpcUrl,
  )

const signer =
  await provider.getSigner(0)

const contract =
  new Contract(
    fixture.contractAddress,
    artifact.abi,
    signer,
  )

const acceptedBefore =
  await contract
    .acceptedBallotCount()

if (
  acceptedBefore !== 0n
) {
  throw new Error(
    "Expected empty synthetic tally before cast",
  )
}

const txStart =
  performance.now()

const tx =
  await contract.castVote(
    ballot.a,
    ballot.b,
    ballot.c,
    ballot.nullifier,
    ballot.rx,
    ballot.ry,
    ballot.sx,
    ballot.sy,
  )

const receipt =
  await tx.wait()

const txLatencyMs =
  performance.now() -
  txStart

if (
  !receipt ||
  receipt.status !== 1
) {
  throw new Error(
    "DIRECT encrypted ballot transaction failed",
  )
}

const acceptedAfter =
  await contract
    .acceptedBallotCount()

if (
  acceptedAfter !== 1n
) {
  throw new Error(
    "Accepted ballot count did not increment",
  )
}

const nullifierUsed =
  await contract
    .usedNullifier(
      ballot.nullifier,
    )

if (
  nullifierUsed !==
  true
) {
  throw new Error(
    "Nullifier not marked used",
  )
}

/*
 * Because this is the first ballot and the accumulator
 * begins at BabyJub identity, each encrypted tally slot
 * must exactly equal that ballot's ciphertext slot.
 */
for (
  let slot = 0;
  slot < 16;
  slot += 1
) {
  const tally =
    await contract
      .getTally(slot)

  const expected = [
    BigInt(
      ballot.rx[slot],
    ),
    BigInt(
      ballot.ry[slot],
    ),
    BigInt(
      ballot.sx[slot],
    ),
    BigInt(
      ballot.sy[slot],
    ),
  ]

  for (
    let coordinate = 0;
    coordinate < 4;
    coordinate += 1
  ) {
    if (
      BigInt(
        tally[coordinate],
      ) !==
      expected[coordinate]
    ) {
      throw new Error(
        `Tally mismatch slot=${slot} coordinate=${coordinate}`,
      )
    }
  }
}

let duplicateRejected =
  false

try {
  const duplicate =
    await contract.castVote(
      ballot.a,
      ballot.b,
      ballot.c,
      ballot.nullifier,
      ballot.rx,
      ballot.ry,
      ballot.sx,
      ballot.sy,
    )

  await duplicate.wait()
} catch {
  duplicateRejected =
    true
}

if (
  !duplicateRejected
) {
  throw new Error(
    "Duplicate nullifier was accepted",
  )
}

const functionFragment =
  contract.interface
    .getFunction(
      "castVote",
    )

const candidateNamedInputs =
  functionFragment.inputs.filter(
    input =>
      /candidate/i.test(
        input.name || "",
      ),
  )

if (
  candidateNamedInputs.length !==
  0
) {
  throw new Error(
    "DIRECT cast ABI exposes a candidate-named input",
  )
}

const calldataBytes =
  (
    tx.data.length -
    2
  ) /
  2

const output = {
  status:
    "PASS",

  txHash:
    receipt.hash,

  blockNumber:
    receipt.blockNumber,

  gasUsed:
    receipt.gasUsed.toString(),

  calldataBytes,

  txLatencyMs,

  acceptedBefore:
    acceptedBefore.toString(),

  acceptedAfter:
    acceptedAfter.toString(),

  nullifierUsed,

  firstBallotTallyMatch:
    true,

  duplicateNullifierRejected:
    true,

  candidateNamedCastInputs:
    candidateNamedInputs.length,

  submissionKeys:
    keys,
}

writeJson(
  outputPath,
  output,
)

console.log(
  "ONCHAIN_DIRECT_CAST=PASS",
)

console.log(
  "ONCHAIN_ACCEPTED_BALLOT_COUNT=1",
)

console.log(
  "ONCHAIN_NULLIFIER_USED=PASS",
)

console.log(
  "ONCHAIN_FIRST_BALLOT_TALLY_MATCH=PASS",
)

console.log(
  "ONCHAIN_DUPLICATE_NULLIFIER_REJECTED=PASS",
)

console.log(
  "ONCHAIN_CAST_CANDIDATE_NAMED_INPUTS=0",
)

console.log(
  `ONCHAIN_CAST_GAS_USED=${receipt.gasUsed}`,
)

console.log(
  `ONCHAIN_CAST_CALLDATA_BYTES=${calldataBytes}`,
)

console.log(
  `ONCHAIN_TX_LATENCY_MS=${txLatencyMs}`,
)
