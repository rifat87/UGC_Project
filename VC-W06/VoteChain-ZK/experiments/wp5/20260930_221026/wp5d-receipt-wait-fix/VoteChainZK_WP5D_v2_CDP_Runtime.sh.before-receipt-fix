  p.candidateManifest?.algorithm !==
  "POSEIDON_INDEXED_CHAIN_V1"
) {
  throw new Error(
    "WP5 indexed manifest freeze missing"
  );
}

if (
  p.directArtifacts?.trustedSetup !==
  "DEV_ONLY"
) {
