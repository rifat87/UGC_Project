#!/usr/bin/env bash
set -euo pipefail

ROOT="$PWD"

if [ "$(basename "$ROOT")" != "VoteChain-ZK" ]; then
    echo "ERROR: run from VoteChain-ZK root."
    exit 2
fi

FRONT="$ROOT/votechain-frontend-ts"
FOUNDRY="$ROOT/contracts/wp4-foundry"

APP_PROFILE="$ROOT/crypto/config/wp5-application-profile.json"
WP3_PROFILE="$ROOT/crypto/config/wp3-build-profile.json"

DIRECT_ARTIFACT="$FOUNDRY/out/VoteChainWP4.sol/VoteChainDirect.json"
VERIFIER_ARTIFACT="$FOUNDRY/out/VoteChainVoteDirectVerifier.sol/VoteChainVoteDirectVerifier.json"

RUN_ID="$(date +%Y%m%d_%H%M%S)"
EVIDENCE="$ROOT/experiments/wp5/$RUN_ID/wp5d-v2-runtime"

OUTROOT="../VoteChain_VC-W03_FinalZK/Output/VC-W07"
SUMMARY="$OUTROOT/VC-W07_WP5D_V2_SYNTHETIC_RUNTIME_SUMMARY.txt"

ANVIL_PORT=8547
VITE_PORT=4174
CDP_PORT=9224

RPC="http://127.0.0.1:$ANVIL_PORT"
VITE_URL="http://127.0.0.1:$VITE_PORT"
CDP_URL="http://127.0.0.1:$CDP_PORT"

ANVIL_PID=""
VITE_PID=""
BROWSER_PID=""

mkdir -p \
    "$EVIDENCE" \
    "$OUTROOT" \
    "$FRONT/scripts"

cleanup() {
    echo
    echo "=== CLEANUP ==="

    if [ -n "${BROWSER_PID:-}" ]; then
        kill "$BROWSER_PID" 2>/dev/null || true
        wait "$BROWSER_PID" 2>/dev/null || true
    fi

    if [ -n "${VITE_PID:-}" ]; then
        kill "$VITE_PID" 2>/dev/null || true
        wait "$VITE_PID" 2>/dev/null || true
    fi

    if [ -n "${ANVIL_PID:-}" ]; then
        kill "$ANVIL_PID" 2>/dev/null || true
        wait "$ANVIL_PID" 2>/dev/null || true
    fi

    rm -f \
        "$FRONT/wp5d-runtime.html" \
        "$FRONT/src/wp5d-runtime.ts" \
        "$FRONT/public/wp5d-runtime-fixture.json" \
        "$FRONT/scripts/wp5d-v2-deploy.mjs" \
        "$FRONT/scripts/wp5d-v2-submit.mjs"

    echo "TEMPORARY_RUNTIME_FILES_REMOVED=YES"
}

trap cleanup EXIT INT TERM

echo
echo "======================================================================"
echo "VOTECHAIN-ZK WP5D-v2 — CDP BROWSER RUNTIME / ONCHAIN CAST"
echo "======================================================================"
echo "RUN_ID=$RUN_ID"
echo
echo "Research functional gate only."
echo "Synthetic voter only."
echo "Synthetic candidate selection only."
echo "No real biometric execution."
echo "No MongoDB access."
echo "No production trusted-setup claim."
echo

###############################################################################
# 1. WP5C / PROFILE PRECONDITIONS
###############################################################################

echo "=== 1. PRECONDITIONS ==="

WP5C_SUMMARY="$OUTROOT/VC-W07_WP5C_LOCAL_PRIVACY_WORKER_SUMMARY.txt"

if [ ! -f "$WP5C_SUMMARY" ]; then
    echo "ERROR: WP5C accepted summary not found."
    exit 10
fi

if ! grep -q \
    '^STATUS=PASS_WP5C_LOCAL_PRIVACY_WORKER_BUILD$' \
    "$WP5C_SUMMARY"
then
    echo "ERROR: WP5C is not accepted."
    exit 11
fi

for f in \
    "$APP_PROFILE" \
    "$WP3_PROFILE" \
    "$FRONT/src/privacy/wp5Privacy.worker.ts" \
    "$FRONT/src/privacy/wp5PrivacyClient.ts" \
    "$FRONT/public/zk/wp5/direct/VoteChainVoteDirect.wasm" \
    "$FRONT/public/zk/wp5/direct/VoteChainVoteDirect_final.zkey" \
    "$FRONT/public/zk/wp5/direct/verification_key.json"
do
    if [ ! -f "$f" ]; then
