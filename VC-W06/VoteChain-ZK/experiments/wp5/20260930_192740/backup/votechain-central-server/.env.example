PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/votechain_test
FRONTEND_ORIGINS=http://localhost:5273
RPC_URL=http://127.0.0.1:8545
# Active VoteChain-ZK contract address.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Exactly 32 bytes. Use a dedicated secret; do not reuse the historical voter-salt key.
ZK_CREDENTIAL_SECRET_KEY=replace-with-32-byte-secret-key!
# Historical VC-W01/VC-W02 baseline only. Not used by the active ZK flow.
VOTER_SALT_SECRET_KEY=baseline-only-32-byte-secret!!!!
MIGRATION_ALLOW_RUN=false
# Optional offline/reproducible official Semaphore proving artifacts. Configure both or neither.
# ZK_SNARK_WASM=/absolute/path/to/semaphore.wasm
# ZK_SNARK_ZKEY=/absolute/path/to/semaphore.zkey

# Optional optimization for on-chain commitment event reconstruction (default: 0)
ZK_CONTRACT_DEPLOYMENT_BLOCK=0

# Existing ESP32/R307 serial integration; override per deployment host.
FINGERPRINT_SERIAL_PORT=COM3
