  marker,
  anchor,
  insertion,
  label,
}) {
  if (
    text.includes(
      marker,
    )
  ) {
    console.log(
      `${label}=ALREADY_PRESENT`,
    )

    return
  }

  const index =
    text.indexOf(
      anchor,
    )

  if (
    index < 0
  ) {
    throw new Error(
      `Cannot locate ${label} anchor`,
    )
  }

  text =
    text.slice(
      0,
      index,
    ) +
    insertion +
    text.slice(
      index,
    )

  console.log(
    `${label}=PATCHED`,
  )
}

if (
  !text.includes(
    "bytes32 public trusteeTranscriptHash;",
  )
) {
  const anchor =
`    uint256 public acceptedBallotCount;

`

