import {
  readFile,
  writeFile,
} from "node:fs/promises"

import {
  Contract,
  ContractFactory,
  JsonRpcProvider,
  Wallet,
} from "ethers"

function hexBytecode(
  artifact,
) {
  const object =
    artifact
      ?.bytecode
      ?.object

  if (
    typeof object !==
      "string" ||
    object.length === 0
  ) {
    throw new Error(
      "artifact bytecode missing",
    )
  }

  return object.startsWith(
    "0x",
  )
    ? object
    : `0x${object}`
}

async function json(
  file,
) {
  return JSON.parse(
    await readFile(
      file,
      "utf8",
    ),
  )
}

async function save(
  file,
  value,
) {
  await writeFile(
    file,
    JSON.stringify(
      value,
      null,
      2,
    ) + "\n",
    "utf8",
  )
}

function sameCiphertext(
  actual,
  expected,
) {
  return (
    String(
      actual.R[0],
    ) ===
      String(
        expected.R[0],
      ) &&
    String(
      actual.R[1],
    ) ===
      String(
        expected.R[1],
      ) &&
    String(
      actual.S[0],
    ) ===
      String(
        expected.S[0],
      ) &&
    String(
      actual.S[1],
    ) ===
      String(
