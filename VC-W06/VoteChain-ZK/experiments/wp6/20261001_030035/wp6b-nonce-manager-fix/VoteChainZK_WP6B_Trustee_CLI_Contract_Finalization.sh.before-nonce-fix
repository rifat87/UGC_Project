#!/usr/bin/env node

import {
  mkdir,
  readFile,
  readdir,
  writeFile,
} from "node:fs/promises"

import {
  dirname,
  join,
  resolve,
} from "node:path"

import {
  addEncryptedBallot,
  context,
  encryptBit,
  zeroTally,
} from "../src/wp2-core-final.mjs"

import {
  WP6,
  buildDkgTranscript,
  canonicalSha256,
  createDkgContribution,
  createPartialRecord,
  createTrusteeTransportIdentity,
  deriveTrusteeShare,
  openTrusteeShare,
  randomScalar,
  serializeCiphertext,
  verifyDkgTranscript,
  verifyFinalizationTranscript,
} from "../src/wp6-threshold.mjs"

function parseArgs(
  argv,
) {
  const out = {}

  for (
    let i = 0;
    i < argv.length;
    i++
  ) {
    const key =
      argv[i]

    if (
      !key.startsWith(
        "--",
      )
    ) {
      throw new Error(
        `Unexpected argument: ${key}`,
      )
    }

    const name =
      key.slice(2)

    const value =
      argv[
        i + 1
      ]

    if (
      value === undefined ||
      value.startsWith(
        "--",
      )
    ) {
      throw new Error(
        `Missing value for --${name}`,
      )
    }

    out[name] =
      value

    i++
  }

  return out
}

function required(
  args,
  name,
) {
  const value =
    args[name]

  if (
    value === undefined ||
    value === ""
  ) {
    throw new Error(
      `Missing --${name}`,
    )
  }

  return value
}

async function readJson(
  file,
) {
  return JSON.parse(
    await readFile(
      resolve(file),
      "utf8",
    ),
  )
}

async function writeJson(
  file,
  value,
) {
  const target =
    resolve(file)

  await mkdir(
    dirname(
      target,
    ),
    {
      recursive: true,
    },
  )

  await writeFile(
    target,
    JSON.stringify(
      value,
      null,
      2,
    ) + "\n",
    "utf8",
  )
}

async function passphrase(
  file,
) {
  const value =
    (
      await readFile(
        resolve(file),
        "utf8",
      )
    ).trim()

  if (
    value.length < 16
  ) {
    throw new Error(
      "passphrase file too short",
    )
  }

  return value
}

async function orderedJsonFiles(
  directory,
) {
  const root =
    resolve(
      directory,
    )

  const files =
    (
      await readdir(
        root,
      )
    )
      .filter(
        name =>
          name.endsWith(
            ".json",
          ),
      )
      .sort(
        (
          a,
          b,
        ) =>
          a.localeCompare(
            b,
            undefined,
            {
              numeric: true,
            },
          ),
      )

  return Promise.all(
    files.map(
      file =>
        readJson(
          join(
            root,
            file,
          ),
        ),
    ),
  )
}

function publicKeyPoint(
  c,
  serialized,
) {
  return [
    c.F.e(
      BigInt(
        serialized[0],
      ),
    ),

    c.F.e(
      BigInt(
        serialized[1],
      ),
    ),
  ]
}

const command =
  process.argv[2]

const args =
  parseArgs(
    process.argv.slice(
      3,
    ),
  )

const c =
  await context()

switch (
